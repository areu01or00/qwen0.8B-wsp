@@ -104,9 +108,29 @@ class WSP:
     def _w_hook(self, l):
         def h(mod, inp, out):
             if self.cap: self.k[l] = inp[0].detach().float()
-            if self.mod: return out + (inp[0].float() @ self.delta[l].T).to(out.dtype)
+            if self.mod: return torch.nn.functional.linear(inp[0], self._merged(l))
         return h
 
+    def _file_dtype(self):
+        from safetensors import safe_open
+        src = self.name if os.path.isdir(self.name) else __import__("huggingface_hub").snapshot_download(self.name)
+        for fn in sorted(os.listdir(src)):
+            if fn.endswith(".safetensors"):
+                with safe_open(os.path.join(src, fn), "pt") as f:
+                    for k in f.keys():
+                        if k.endswith("mlp.down_proj.weight"):
+                            return {"BF16": torch.bfloat16, "F16": torch.float16, "F32": torch.float32}[f.get_slice(k).get_dtype()]
+        return torch.bfloat16
+
+    def _merged(self, l):
+        """The edited matrix exactly as save() writes it: (W + dW) rounded to the file's dtype (bf16), so every check
+        and every correction round measures the weights that ship, not an fp32 side term (they round differently)."""
+        d = self.delta[l]; key = (d.data_ptr(), d._version, d.sum().item())   # freed memory can be reused: sum guards it
+        if self._mcache.get(l, (None,))[0] != key:
+            W = self.W[l].weight
+            self._mcache[l] = (key, (self.W0[l].float() + d).to(self.fdt).to(W.dtype))
+        return self._mcache[l][1]
+
     def _top_hook(self, mod, inp, out):
         if self.cap: self.hL = (out[0] if isinstance(out, tuple) else out).detach().float()
 
